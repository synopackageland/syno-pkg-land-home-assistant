{
  "name": "synopkgland-home-assistant",
  "private": true,
  "type": "module",
  "scripts": {
    "render": "python3 scripts/render-compose.py",
    "test": "python3 -m unittest discover -s tests && npm run test:entry",
    "check": "synopkgland check --json",
    "build": "synopkgland build --arch x86_64 --json",
    "test:entry": "cd tests/entry && go test -count=1 ./...",
    "e2e:smoke": "node --env-file-if-exists=.env node_modules/e2e/dist/cli/bin.js run tests/e2e/smoke.e2e.ts"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.91",
    "@e2e-dev/web": "0.14.0",
    "@synopackageland/cli": "0.41.9",
    "@synopackageland/templates": "0.35.5",
    "ai": "7.0.137",
    "e2e": "0.19.0",
    "playwright": "1.63.0"
  }
}
